{
  "name": "active-theme",
  "version": "0.1.0",
  "description": "Mode + color theme engine — CSS variables on :root, optional React / Emotion / active-state adapters",
  "type": "module",
  "license": "MIT",
  "author": "Calvin Maighan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalvinMaighan/active-theme.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/react/index.js",
    "./dist/state/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lite": {
      "types": "./dist/lite/index.d.ts",
      "import": "./dist/lite/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./emotion": {
      "types": "./dist/emotion/index.d.ts",
      "import": "./dist/emotion/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepare": "bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build && bun test"
  },
  "peerDependencies": {
    "@calvinjs/active-state": ">=0.1.0",
    "react": ">=18",
    "@emotion/react": ">=11"
  },
  "peerDependenciesMeta": {
    "@calvinjs/active-state": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@emotion/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@calvinjs/active-state": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "react": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
