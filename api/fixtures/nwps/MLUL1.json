    "impacts": [
      {
        "stage": 54.4,
        "statement": "Catastrophic flooding occurrs with water overtopping numerous levees in the Monroe area.  High water laps at the bottom of the U.S. Highway 80 bridge."
      },
      {
        "stage": 49,
        "statement": "Major flooding between the levees occurs and the floodwall gap must be closed on the East Monroe side of the river."
      },
      {
        "stage": 47.5,
        "statement": "Water floods the underclearance of the Desiard Street bridge. Major lowland flooding occurs between the levee systems."
      },
      {
        "stage": 45,
        "statement": "The Prairon Bayou recreational area floods and closes.  Lowland flooding becomes extensive at this stage between levees."
      },
      {
        "stage": 43,
        "statement": "The Bawcomville and Moon Lake recreational areas flood and close."
      },
      {
        "stage": 40,
        "statement": "Minor backwater flooding affects small bayous that drain into the Ouachita River along with minor lowland flooding between levee systems."
      },
      {
        "stage": 36,
        "statement": "Both the Forsythe and Lazarre recreational areas flood and close with very minor lowland flooding immediately next to the river."
      },
      {
        "stage": 34,
        "statement": "The Forsythe Recreational Area closes, otherwise no other flooding occurs in the Monroe area until a stage of 36 feet."
      }
    ]
  },
